{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claims-handoff-copilot/schemas/synthesis_result.schema.json",
  "title": "SynthesisResult",
  "description": "What one Analyze produces. data/schema.md §1.3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["synthesis_id", "claim_id", "generated_at", "checkpoint", "document_set", "model_id", "prompt_version", "header", "timeline", "facts", "differences", "open_questions", "coverage", "not_assessed"],
  "properties": {
    "synthesis_id": { "type": "string" },
    "claim_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "checkpoint": { "enum": ["C1", "C2", "C3", "C4", "C5"] },
    "document_set": {
      "type": "array",
      "description": "D-020 P6. Which documents, at which versions, this was derived from. Claim files are discoverable; without this nobody can later establish what the system actually saw.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "version"],
        "properties": {
          "document_id": { "type": "string" },
          "version": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    },
    "model_id": { "type": ["string", "null"], "description": "null if no LLM stage ran." },
    "prompt_version": { "type": ["string", "null"] },
    "header": { "$ref": "#/$defs/ClaimHeader" },
    "timeline": { "type": "array", "items": { "$ref": "#/$defs/TimelineEvent" } },
    "facts": { "type": "array", "items": { "$ref": "https://claims-handoff-copilot/schemas/fact.schema.json" } },
    "differences": { "type": "array", "items": { "$ref": "https://claims-handoff-copilot/schemas/difference.schema.json" } },
    "open_questions": { "type": "array", "items": { "$ref": "https://claims-handoff-copilot/schemas/open_question.schema.json" } },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents_total", "documents_processed", "passages_total", "passages_processed", "facts_dropped"],
      "properties": {
        "documents_total": { "type": "integer" },
        "documents_processed": { "type": "integer" },
        "documents_withheld_by_checkpoint": { "type": "integer" },
        "passages_total": { "type": "integer" },
        "passages_processed": { "type": "integer" },
        "facts_dropped": { "type": "integer", "description": "Count of facts removed by the drop-if-uncitable rule." }
      }
    },
    "not_assessed": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "D-020 P5, absence is stated not implied. An empty differences list is otherwise ambiguous between 'no differences found' and 'differences not assessed'. ALWAYS contains at least the materiality entry."
    }
  },
  "$defs": {
    "ClaimHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "loss_description", "jurisdiction", "damages", "status", "reserve"],
      "description": "The structured replacement for the narrative summary (D-025). Subheads taken from large loss report practice. No long generation for hallucinations to cluster at the end of, and no room for generic vacuity: a field either resolves to facts or declares itself absent.",
      "properties": {
        "coverage": { "$ref": "#/$defs/HeaderField" },
        "loss_description": { "$ref": "#/$defs/HeaderField" },
        "jurisdiction": { "$ref": "#/$defs/HeaderField" },
        "damages": { "$ref": "#/$defs/HeaderField" },
        "status": { "$ref": "#/$defs/HeaderField" },
        "reserve": { "$ref": "#/$defs/HeaderField" }
      }
    },
    "HeaderField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "state", "fact_ids"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "state": {
          "enum": ["present", "absent_from_file", "not_assessed"],
          "description": "Three values, not two. 'Absent from the file' and 'we did not look' are different things."
        },
        "fact_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "TimelineEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "axis", "when", "label", "source_fact_ids", "ordering_confidence"],
      "description": "DERIVED, never stored. Recomputed from Facts carrying a Date normalised_value. Storing it would create two sources of truth for one date.",
      "properties": {
        "event_id": { "type": "string" },
        "axis": {
          "enum": ["occurred", "became_known"],
          "description": "Two axes, both required in the output. The became_known axis is what a successor actually needs and is what a chronology of the loss alone does not give them."
        },
        "when": { "$ref": "https://claims-handoff-copilot/schemas/fact.schema.json#/$defs/NormalisedValue" },
        "label": { "type": "string" },
        "source_fact_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "ordering_confidence": {
          "enum": ["exact", "approximate", "unorderable"],
          "description": "unorderable is what a precision:vague date produces. The event still appears — not silently dropped, not given a false position."
        }
      }
    }
  }
}
