# Copy to .streamlit/secrets.toml for local runs (gitignored), or paste the
# same line into Streamlit Cloud: App settings -> Secrets.
#
# Without it the app still runs — every panel works against the frozen E2 run —
# and only document ingestion is disabled, with the reason shown on the page.
OPENROUTER_API_KEY = "sk-or-v1-replace-me"
